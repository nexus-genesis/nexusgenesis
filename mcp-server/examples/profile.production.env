# NexusGenesis Deployment Profile — production (全操作键 + artifact 绑定 + 多实例 store)
#
# 内建三档 profile 之一。production 强约束（fail-closed）：
#   - 必须显式 CHAIN_RPC_URL + 全部三个操作私钥（owner/emergency/relayer）。
#   - 拒绝众所周知的 anvil 测试私钥。
#   - REQUIRE SMART_ACCOUNT_ARTIFACT 显式路径（缺 → 启动报错）。
#   - 多实例必须用共享 SQLite store（NEXUS_STORE_BACKEND=sqlite），否则跨实例
#     协调/去重失效。
# 密钥提示：生产环境绝不可把真实私钥写进本文件明文。建议用 env 注入或密钥文件，
# 本文件只放非密钥配置。以下 CHAIN_*_PK 用占位说明——若走此文件，替换为受控渠道
# 注入的引用。
CHAIN_PROFILE=production
# 绝不使用众所周知的 anvil 默认键：
# CHAIN_OWNER_PK / CHAIN_EMERGENCY_PK / CHAIN_RELAYER_PK 必须显式提供且互不相同。

CHAIN_RPC_URL=https://mainnet.example.org/rpc
# artifact 必须存在并绑定 solc 0.8.24（chain-config 会校验版本/合约身份）。
SMART_ACCOUNT_ARTIFACT=./contracts/solidity/out/SmartAccount.sol/SmartAccount.json
SMART_ACCOUNT_SOLC_VERSION=0.8.24
SMART_ACCOUNT_STATE_FILE=./data/state-prod.json
SIMULATION_LOG_FILE=./data/sim-prod.json

# 多实例共享后端（协调/去重/防重放必需）。
NEXUS_STORE_BACKEND=sqlite
NEXUS_INSTANCE_ID=prod-01

# 可观测（建议开启）。
METRICS_HTTP_PORT=9091
HEALTH_HTTP_PORT=9092

# 审计落盘 + 体积滚动 + 集中式收集（可选）。
AUDIT_LOG_FILE=./data/audit-prod.jsonl
AUDIT_LOG_MAX_BYTES=10485760
AUDIT_HTTP_PORT=9093