{
  "name": "nexusgenesis-node",
  "version": "1.0.0-bootstrap.1",
  "description": "NexusGenesis — Agent autonomous key-custody & authorization standard layer. The original L1 has been archived (see archive/L1/).",
  "type": "module",
  "workspaces": [
    "packages/*",
    "mcp-server",
    "examples"
  ],
  "scripts": {
    "start": "npm run start --workspace mcp-server",
    "dev": "node --watch mcp-server/src/server.js",
    "test:release-packages": "npm run test --workspace packages/agent-keys --workspace packages/agent-sdk --workspace packages/chain-eth --workspace packages/chain-sol --workspace packages/chain-adapters --workspace mcp-server --if-present",
    "smoke:release": "node scripts/release-smoke.mjs",
    "sync:deny-list": "node scripts/sync-deny-list.mjs",
    "check:deny-list": "node scripts/sync-deny-list.mjs --check",
    "release:bump": "node scripts/release-bump.mjs",
    "release:bump:apply": "node scripts/release-bump.mjs --apply",
    "release:preflight": "node scripts/release-preflight.mjs"
  },
  "dependencies": {
    "@noble/post-quantum": "^0.6.1",
    "@octokit/rest": "^22.0.1",
    "axios": "^1.15.0",
    "bip39": "^3.1.0",
    "bs58": "^6.0.0",
    "buffer": "^6.0.3",
    "commander": "^11.0.0",
    "cors": "^2.8.6",
    "discord.js": "^14.25.1",
    "dotenv": "^17.3.1",
    "ethers": "^6.16.0",
    "express": "^5.2.1",
    "node-fetch": "^3.3.2",
    "openai": "^6.25.0",
    "superdilithium": "^2.0.6",
    "tweetnacl": "^1.0.3",
    "tweetnacl-util": "^0.15.1",
    "uuid": "^9.0.0",
    "ws": "^8.19.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "ai-agents",
    "agent-security",
    "agent-custody",
    "key-management",
    "post-quantum",
    "dilithium",
    "pqc",
    "self-custody",
    "human-takeover",
    "authorization",
    "session-keys",
    "mcp",
    "llm",
    "agentic"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@ethereumjs/block": "^10.1.2",
    "@ethereumjs/common": "^10.1.2",
    "@ethereumjs/statemanager": "^10.1.2",
    "@ethereumjs/tx": "^10.1.2",
    "@ethereumjs/util": "^10.1.2",
    "@ethereumjs/vm": "^10.1.2",
    "esbuild": "^0.28.2",
    "nodemon": "^3.1.14"
  }
}
